# Copy to .env (project root). Never commit .env.

# --- LiveKit (WebRTC rooms + agent dispatch) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- STT ---
DEEPGRAM_API_KEY=
# Azure Speech F0 (free): native fil-PH / id-ID / en-IN TTS + STT
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional bake-off providers
GLADIA_API_KEY=
ELEVENLABS_API_KEY=

# --- LLM: any OpenAI-compatible endpoint (Groq / Cerebras) ---
# Voice agent
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional second account for failover only (used when the first key hits its daily quota)
LLM_API_KEY2=
# Fallback chain on 429/outage; 'model@ENV_VAR' = same model on that env var's key (skipped if unset)
LLM_FALLBACK_MODELS=openai/gpt-oss-120b@LLM_API_KEY2,qwen/qwen3.8-27b,openai/gpt-oss-20b
# gpt-oss reasoning effort (low keeps voice latency down)
LLM_REASONING_EFFORT=low
# Fast small model: per-turn field extraction (voice agent) + live signal classifier (copilot).
# Falls back to LLM_* for anything unset.
FAST_LLM_BASE_URL=
FAST_LLM_API_KEY=
FAST_LLM_MODEL=openai/gpt-oss-20b
FAST_LLM_FALLBACK_MODELS=openai/gpt-oss-20b@LLM_API_KEY2,qwen/qwen3.8-27b
# Simulated caller bot (falls back to LLM_* if unset)
SIM_LLM_BASE_URL=
SIM_LLM_API_KEY=
SIM_LLM_MODEL=qwen/qwen3.8-27b
SIM_LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# --- TTS: per-pack provider chain comes from backend/packs/*/pack.yaml; these override ---
# TTS_PROVIDER=azure          # azure | deepgram | fish | sarvam
# TTS_VOICE=
# TTS_LANGUAGE=
TTS_SAMPLE_RATE=24000
# Keys for the original providers (optional)
FISH_API_KEY=
SARVAM_API_KEY=
SARVAM_TTS=off

# Turn-taking arbiter LLM stage (defaults to FAST_LLM_*)
# TURN_ARBITER_MODEL=
# TURN_ARBITER_TIMEOUT_MS=400
# on | off (off = punctuation/lexicon heuristics only; STT finals are punctuated, so the LLM stage rarely helps)
TURN_ARBITER_LLM=on

# Short-answer fast path: resolve plain answers without the extraction LLM / speak approved next questions
QUICK_ANSWERS=on
FAST_REPLIES=on

# --- Backend / app ---
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Shared secret the copilot worker uses to publish into the hub
COPILOT_HUB_TOKEN=change-me
# Optional outbound escalation / CRM webhook (mock CRM is built in)
ESCALATION_WEBHOOK_URL=
# Default pack when none is given: in_health | ph_life | id_multifinance
DEFAULT_PACK=in_health
# KB retrieval
KB_RERANK=false
NEXUS_IDLE_TIMEOUT_SECONDS=45
REPROMPT_AFTER_S=10   # seconds of silence before 'are you still there?' (default 10)
